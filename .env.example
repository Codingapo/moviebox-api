# Optional overrides (defaults work for most setups)

# Public base used for embed links (supaplay)
SUPAPLAY_PUBLIC_BASE=https://supaplay.fun

# Upstream MovieBox-style sites
MOVIEBOX_SITE=https://123movienow.cc
MOVIEBOX_DETAIL_API=https://h5-api.aoneroom.com/wefeed-h5api-bff/detail
SEARCH_API_DOMAIN=h5-api.aoneroom.com

# Channel IDs used by genre / filter
MOVIEWATCH_MOVIES_CHANNEL_ID=1
MOVIEWATCH_TV_CHANNEL_ID=2

# Timeouts (seconds)
UPSTREAM_TIMEOUT=20
DETAIL_TIMEOUT=22

# CORS (comma-separated origins, or * )
CORS_ORIGINS=*
